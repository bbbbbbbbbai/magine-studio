# PostgreSQL
POSTGRES_DB=imagine
POSTGRES_USER=imagine
POSTGRES_PASSWORD=imagine_dev_password
DATABASE_URL=postgresql+asyncpg://imagine:imagine_dev_password@db:5432/imagine

# Prompt understanding / enhancement (LangChain + OpenAI-compatible LLM)
LLM_MODEL=deepseek-v4-flash-vision-exp
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.4

# Image generation
# IMAGE_MODEL is the model selected by default.
# Supported values: flux, gpt-image-2.5, qwen-image-3-pro, z-image-pro,
# anime-v4-5, seedream-5-pro, anime-v5.
# Pollinations Flux works without a key and remains available in the model picker.
IMAGE_PROVIDER=pollinations
IMAGE_MODEL=flux
POLLINATIONS_MODEL=flux

# GPT Image 2.5 via an OpenAI-compatible POST /images/generations endpoint.
GPT_IMAGE_MODEL=gpt-image-2.5
GPT_IMAGE_API_BASE_URL=https://api.openai.com/v1
GPT_IMAGE_API_KEY=

# Legacy generic OpenAI-compatible fallback.
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_TIMEOUT_SECONDS=150

# Application
DATABASE_ECHO=false
AUTO_CREATE_TABLES=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

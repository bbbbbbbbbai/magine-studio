# PostgreSQL
POSTGRES_DB=imagine
POSTGRES_USER=imagine
POSTGRES_PASSWORD=imagine_dev_password
DATABASE_URL=postgresql+asyncpg://imagine:imagine_dev_password@db:5432/imagine

# Prompt understanding / enhancement (LangChain + OpenAI-compatible LLM)
LLM_MODEL=deepseek-v4-flash-vision-exp
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.4

# Image generation
# pollinations works without a key and is the default for the local MVP.
# Use openai for any service implementing POST /images/generations.
IMAGE_PROVIDER=pollinations
IMAGE_MODEL=flux
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_TIMEOUT_SECONDS=150

# Application
DATABASE_ECHO=false
AUTO_CREATE_TABLES=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

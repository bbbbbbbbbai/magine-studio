# PostgreSQL
POSTGRES_DB=imagine
POSTGRES_USER=imagine
POSTGRES_PASSWORD=imagine_dev_password
DATABASE_URL=postgresql+asyncpg://imagine:imagine_dev_password@db:5432/imagine

# Prompt understanding / enhancement (LangChain + OpenAI-compatible LLM)
LLM_MODEL=deepseek-v4-flash-vision-exp
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.4

# Image generation
# IMAGE_MODEL is the model selected by default.
# Supported values: flux, z-image-2.5, gpt-image-2.5, qwen-image-3-pro, z-image-pro,
# anime-v4-5, seedream-5-pro, anime-v5.
# Pollinations Flux works without a key and remains available in the model picker.
IMAGE_PROVIDER=pollinations
IMAGE_MODEL=z-image-2.5
POLLINATIONS_MODEL=flux
Z_IMAGE_MODEL=z-image-2.5

# GPT Image 2.5 via an OpenAI-compatible POST /images/generations endpoint.
GPT_IMAGE_MODEL=gpt-image-2.5
GPT_IMAGE_API_BASE_URL=https://api.openai.com/v1
GPT_IMAGE_API_KEY=

# Legacy generic OpenAI-compatible fallback.
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_TIMEOUT_SECONDS=150

# Application
DATABASE_ECHO=false
AUTO_CREATE_TABLES=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Fixed Root identity. When empty, the first registered UUID becomes Root.
ROOT_USER_UUID=e8b2ee31-0e36-4d52-a601-ab37d18bf6d5

# Character reference library (frontend build-time settings)
# The default keeps the 4 MB metadata index and image assets on their public
# source. Point both values at your own storage when self-hosting the assets.
VITE_REFERENCE_DATA_BASE=https://raw.githubusercontent.com/anhao/ai-pose-gallery-zh/main
VITE_REFERENCE_ASSET_BASE=https://ai-pose-gallery.anhao.app
